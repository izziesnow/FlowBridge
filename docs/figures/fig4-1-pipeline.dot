digraph pipeline {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.45, pad=0.25, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#eef2f7", color="#5b6b7f", penwidth=1.1, margin="0.14,0.08"];
  edge  [color="#5b6b7f", arrowsize=0.7, fontname="Helvetica", fontsize=9];

  push [label="Developer pushes\nto main (Git)", fillcolor="#ffffff"];

  subgraph cluster_ci {
    label="GitHub Actions workflow (every push)"; fontsize=11; style="rounded,dashed"; color="#8a99ad";
    test [label="test\n• migrations check\n• Django system and\n  deployment checks\n• pytest + coverage\n  (PostgreSQL 16 service)", fillcolor="#e6f4f2", color="#0f766e"];
    e2e  [label="e2e\n• Playwright journeys\n  T1–T5 (Chromium)\n• axe-core WCAG 2.2\n  AA scan", fillcolor="#e8eefb", color="#0a58ca"];
    smoke [label="compose-smoke\n• build and start Nginx,\n  Gunicorn, PostgreSQL\n• HTTPS and header checks\n• backup → wipe →\n  restore → verify\n• load evaluation data\n• Locust: 20 users, 3 min", fillcolor="#fff4e5", color="#b45309"];
  }
  reports [label="Artifacts\ncoverage report\naxe reports\nLocust report", shape=note, fillcolor="#ffffff"];

  push -> test;
  test -> e2e  [label="needs"];
  test -> smoke [label="needs"];
  e2e -> reports; smoke -> reports; test -> reports;
}
