digraph deployment {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.55, pad=0.25, bgcolor="white", compound=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#eef2f7", color="#5b6b7f", margin="0.14,0.08"];
  edge  [color="#5b6b7f", arrowsize=0.7, fontname="Helvetica", fontsize=9];

  browser [label="Web browser\n(staff)", shape=box, fillcolor="#ffffff"];

  subgraph cluster_host {
    label="Docker Compose host (one server)"; style="rounded,dashed"; color="#8a99ad";
    nginx [label="nginx\nNginx 1.27\nHTTPS :8443, HTTP→HTTPS :8080\nsecurity headers, static files", fillcolor="#e8eefb", color="#0a58ca"];
    web [label="web\nDjango 5.2 under Gunicorn\n(3 workers)\nmigrate + collectstatic at start", fillcolor="#e6f4f2", color="#0f766e"];
    sched [label="scheduler\nevery 15 min:\nsend_reminders, send_emails", fillcolor="#e6f4f2", color="#0f766e"];
    db [label="db\nPostgreSQL 16\nrow locks, constraints,\nimmutability triggers", shape=cylinder, fillcolor="#f3f0fa", color="#6d28d9"];
    backup [label="backup\ndaily pg_dump + document\narchive, SHA-256 checked,\nkept 14 days", fillcolor="#fff4e5", color="#b45309"];
    media [label="private_media volume\ndocuments (never served\nby Nginx)", shape=folder, fillcolor="#ffffff"];
    static [label="static volume", shape=folder, fillcolor="#ffffff"];
  }
  backups [label="./backups\non the host", shape=folder, fillcolor="#ffffff"];

  browser -> nginx [label="HTTPS"];
  nginx -> web [label="proxy :8000"];
  nginx -> static [style=dashed, arrowhead=none];
  web -> static [style=dashed, label="collectstatic"];
  web -> db; sched -> db;
  web -> media [label="read/write\n(checksum checked)"];
  backup -> db [label="pg_dump"];
  backup -> media [style=dashed];
  backup -> backups;
}
