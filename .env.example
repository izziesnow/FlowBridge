# Copy to .env and adjust. Never commit a real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=flowbridge
POSTGRES_USER=flowbridge
POSTGRES_PASSWORD=flowbridge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Folder for uploaded documents. Kept outside the web root and never served directly.
PRIVATE_MEDIA_ROOT=./private_media
